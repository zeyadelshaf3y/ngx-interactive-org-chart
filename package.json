{
  "name": "ngx-interactive-org-chart",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "pnpm build:lib && pnpm build:demo",
    "build:lib": "ng build ngx-interactive-org-chart --configuration production",
    "build:demo": "ng build demo --configuration production --output-path docs --base-href /ngx-interactive-org-chart/",
    "build:icons": "pnpm dlx svg-sprite -s -o projects/demo/src/assets/icons/ --symbol-dest projects/demo/src/assets/icons/ projects/demo/src/assets/icons/*.svg",
    "watch": "ng build --watch --configuration development",
    "watch:lib": "ng build ngx-interactive-org-chart --watch --configuration development",
    "test": "ng test",
    "pack": "pnpm build:lib && cd dist/ngx-interactive-org-chart && pnpm pack",
    "publish": "pnpm build:lib && cd dist/ngx-interactive-org-chart && pnpm publish --no-git-checks",
    "deploy": "pnpm build:demo && cp -r docs/browser/* docs/ && cp docs/index.html docs/404.html && rm -rf docs/browser",
    "format": "prettier --write \"**/*.{ts,js,html,scss,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,html,scss,css,json,md}\"",
    "format:staged": "prettier --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,html,scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/forms": "^22.0.5",
    "@angular/platform-browser": "^22.0.5",
    "@angular/router": "^22.0.5",
    "panzoom": "^9.4.4",
    "rxjs": "~7.8.0",
    "svg-sprite": "^2.0.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.0.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "ng-packagr": "^22.0.1",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
